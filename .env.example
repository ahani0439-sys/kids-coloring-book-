# Server environment variables. Set them in Render > your service > Environment.
# Never put real values in this file, in Git, or in the browser.

# Required. Safari asks for it when you open the app (any username works).
APP_PASSWORD=

# Image generation: "replicate" or "openai" (leave empty to use uploads only)
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-schnell   # or black-forest-labs/flux-dev (better, ~8x the price)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium                      # low | medium | high
MAX_GENERATIONS_PER_DAY=60                         # spending guard
# GENERATION_CONCURRENCY=2

# Storage
DATA_DIR=/var/data
STORAGE_BACKEND=s3                                 # "s3" (Cloudflare R2 etc.) or "local" (persistent disk)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=dino-book-factory
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=dino-book/
