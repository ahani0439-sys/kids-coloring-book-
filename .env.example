# Copy to your host's environment settings. Never commit real values.
APP_PASSWORD=choose-a-long-password
DATA_DIR=/var/data
# Image generation: "replicate" (FLUX schnell, a fraction of a cent per image) or "openai" (gpt-image-1)
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-schnell
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
